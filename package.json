{
  "name": "@papercusp/chat-protocol",
  "version": "0.1.0",
  "description": "Deps-free streaming-chat wire contract — SSE event union + interactive-card protocol. Shared across Restart (Scout) and papercusp.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/conformance.ts",
      "import": "./src/testing/conformance.ts",
      "default": "./src/testing/conformance.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@papercusp/test-config": "*",
    "@types/node": "^22.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.4"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
